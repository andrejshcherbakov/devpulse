{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "devpulse",
  "displayName": "DevPulse — Worklog & Standup",
  "description": "Privacy-controlled developer activity analytics and evidence-based standup drafts for self-hosted DevPulse.",
  "version": "0.0.1",
  "publisher": "andrejshcherbakov",
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejshcherbakov/devpulse"
  },
  "bugs": {
    "url": "https://github.com/andrejshcherbakov/devpulse/issues"
  },
  "homepage": "https://github.com/andrejshcherbakov/devpulse#readme",
  "keywords": [
    "time tracking",
    "standup",
    "worklog",
    "productivity",
    "ai",
    "developer tools",
    "git",
    "telemetry"
  ],
  "categories": [
    "Other",
    "Visualization",
    "Machine Learning"
  ],
  "galleryBanner": {
    "color": "#0f0e0d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DevPulse reads Git metadata and observes workspace activity, so it runs only after the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "DevPulse requires a local or remote filesystem workspace with Git and terminal APIs."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devpulse.setApiKey",
        "title": "DevPulse: Set API Key"
      },
      {
        "command": "devpulse.clearApiKey",
        "title": "DevPulse: Clear API Key"
      },
      {
        "command": "devpulse.showMenu",
        "title": "DevPulse: Show Menu"
      },
      {
        "command": "devpulse.pauseTracking",
        "title": "DevPulse: Pause Tracking"
      },
      {
        "command": "devpulse.resumeTracking",
        "title": "DevPulse: Resume Tracking"
      },
      {
        "command": "devpulse.openDashboard",
        "title": "DevPulse: Open Dashboard"
      },
      {
        "command": "devpulse.openSessions",
        "title": "DevPulse: Open Sessions"
      },
      {
        "command": "devpulse.showLog",
        "title": "DevPulse: Show Log"
      },
      {
        "command": "devpulse.showDiagnostics",
        "title": "DevPulse: Show Diagnostics"
      }
    ],
    "configuration": {
      "title": "DevPulse",
      "properties": {
        "devpulse.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable DevPulse activity tracking after an API key and secure API URL are configured.",
          "scope": "machine",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        },
        "devpulse.apiUrl": {
          "type": "string",
          "default": "",
          "description": "DevPulse backend base URL. HTTPS is required except for localhost.",
          "examples": [
            "http://localhost:3000/api/v1",
            "https://devpulse.example.com/api/v1"
          ],
          "scope": "machine",
          "tags": [
            "usesOnlineServices"
          ]
        },
        "devpulse.dashboardUrl": {
          "type": "string",
          "default": "",
          "description": "DevPulse dashboard URL used by quick-menu links. HTTPS is required except for localhost.",
          "examples": [
            "http://localhost:3001",
            "https://devpulse.example.com"
          ],
          "scope": "machine",
          "tags": [
            "usesOnlineServices"
          ]
        },
        "devpulse.sendFilePaths": {
          "type": "boolean",
          "default": true,
          "description": "Send workspace-relative file paths for hot-file analytics. File contents and absolute file paths are never sent.",
          "scope": "machine",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        },
        "devpulse.sendTerminalCommands": {
          "type": "boolean",
          "default": true,
          "description": "Send sanitized terminal command text, workspace-relative working directory, exit code, and duration.",
          "scope": "machine",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        },
        "devpulse.sendCommitMessages": {
          "type": "boolean",
          "default": true,
          "description": "Send Git commit messages for worklog context. Commit hashes and aggregate diff statistics are still sent when disabled.",
          "scope": "machine",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        },
        "devpulse.detectAiAssistance": {
          "type": "boolean",
          "default": true,
          "description": "Locally detect likely AI-assisted insertions and send only the detected tool name and an estimated-interaction marker. Inserted text is never sent.",
          "scope": "machine",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "node esbuild.mjs",
    "package:vsix": "vsce package --no-dependencies",
    "watch": "node esbuild.mjs --watch",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@devpulse/env": "workspace:*",
    "@devpulse/eslint-config": "workspace:*",
    "@devpulse/lib": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.19.17",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
