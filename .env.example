# PostgreSQL Database
POSTGRES_USER=devpulse_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=devpulse_db
DATABASE_URL=postgresql://devpulse_user:replace-with-a-long-random-password@localhost:5432/devpulse_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Backend runtime
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3001

# Set this only in production when the dashboard and API use subdomains of the
# same parent domain, for example: .devpulse-app.dev
# COOKIE_DOMAIN=.devpulse-app.dev

# Transactional email (account verification)
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=DevPulse <noreply@devpulse-app.dev>

# API URLs
DEVPULSE_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional web proxy target. In production on Vercel, set this to the Heroku
# origin and point NEXT_PUBLIC_API_URL to https://<project>.vercel.app/api/v1.
# DEVPULSE_BACKEND_ORIGIN=https://<app>.herokuapp.com
